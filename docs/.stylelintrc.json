{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "/^--/",
        "fill",
        "stroke",
        "z-index",
        "font-size",
        "line-height",
        "/^padding/",
        "/^margin/",
        "/^gap$/",
        "/gap$/",
        "/^border-radius/",
        "transition-duration",
        "animation-duration",
        "box-shadow"
      ],
      {
        "ignoreValues": [
          "currentColor",
          "transparent",
          "inherit",
          "initial",
          "unset",
          "revert",
          "none",
          "auto",
          "0",
          "1px",
          "100%"
        ],
        "ignoreFunctions": false,
        "disableFix": true,
        "message": "PC-1: use a design token (var(--\u2026)), not a literal"
      }
    ],
    "declaration-no-important": true,
    "selector-max-compound-selectors": 2,
    "selector-max-id": 0,
    "custom-property-pattern": "^_?[a-z][a-z0-9]*(-{1,2}[a-z0-9]+)*$",
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "utility",
          "custom-variant",
          "source",
          "reference",
          "apply",
          "variant",
          "config",
          "plugin"
        ]
      }
    ],
    "custom-property-empty-line-before": null
  },
  "overrides": [
    {
      "files": ["**/tokens.css"],
      "rules": {
        "scale-unlimited/declaration-strict-value": null,
        "custom-property-pattern": null
      }
    },
    {
      "files": ["src/lib/examples/*.css"],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ]
}
