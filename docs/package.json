{
  "name": "ninja-keys-docs",
  "version": "0.0.0",
  "private": true,
  "description": "The ninja-keys documentation site",
  "type": "module",
  "scripts": {
    "library": "pnpm --dir .. run build && pnpm --dir .. run analyze",
    "api": "typedoc --options typedoc.config.mjs",
    "predev": "pnpm run library && pnpm run api",
    "dev": "vite dev",
    "prebuild": "pnpm run library && pnpm run api",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm run api && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . && eslint . --max-warnings=0 && stylelint \"src/**/*.css\" && pnpm run lint:semgrep",
    "lint:semgrep": "cd .lint && EIO_BACKEND=posix poetry run semgrep --config ../.semgrep --error --quiet --exclude 'theme-*.css' ../src",
    "format": "prettier --write .",
    "verify": "pnpm run library && pnpm run check && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "catsearch": "file:../../../python-tools/textual-catsearch/js",
    "ninja-keys": "workspace:*"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.72.0",
    "@shikijs/twoslash": "^4.6.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "custom-elements-manifest": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.14.0",
    "hast-util-from-html": "^2.1.0",
    "lucide-static": "^1.72.0",
    "marked": "^18.2.0",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.6.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-csstree": "^0.4.2",
    "tailwindcss": "^4.3.5",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.8"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
